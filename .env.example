# MailPulse 本地配置模板。复制为 .env 后再按部署环境修改。
# 运行环境标识：development 允许开发默认值；production/prod 要求显式配置生产密钥。
# 该配置不会自动切换数据库、日志或其他服务实现。
MAILPULSE_ENVIRONMENT=development
MAILPULSE_HOST=127.0.0.1
MAILPULSE_PORT=8080
MAILPULSE_DATA_DIR=var
MAILPULSE_LOG_LEVEL=INFO
MAILPULSE_LOG_ROTATION="00:00"
MAILPULSE_LOG_RETENTION="30 days"
MAILPULSE_REMEMBER_ME_DAYS=30

# 必须替换为随机长字符串；生产环境不能使用示例值。
MAILPULSE_SECRET_KEY=replace-with-a-random-session-secret
MAILPULSE_CREDENTIAL_KEY=replace-with-a-separate-credential-secret

# 首次启动且数据库中没有管理员时使用；通常保持默认值即可。
# MAILPULSE_DEFAULT_ADMIN_EMAIL=admin@mailpulse.local
# MAILPULSE_DEFAULT_ADMIN_PASSWORD=admin123
# MAILPULSE_DEFAULT_ADMIN_DISPLAY_NAME=系统管理员

# 默认只允许访问本机 AI 服务；外部 AI 必须经过明确策略审核。
MAILPULSE_EXTERNAL_AI_ALLOWED=false

# 可选：不使用管理员模型目录时，可通过环境变量配置主模型。
# MAILPULSE_AI_BASE_URL=http://127.0.0.1:8000/v1
# MAILPULSE_AI_API_KEY=replace-with-your-local-model-key
# MAILPULSE_AI_MODEL=Qwen3.8-27B-MLX-4bit
# MAILPULSE_AI_PRIMARY_SUPPORTS_IMAGE=false
