# MailPulse 本地配置模板。复制为 .env 后再按部署环境修改。
# 运行环境标识：development 允许开发默认值；production/prod 要求显式配置生产密钥。
# 该配置不会自动切换数据库、日志或其他服务实现。
MAILPULSE_ENVIRONMENT=development
MAILPULSE_HOST=127.0.0.1
MAILPULSE_PORT=8080
MAILPULSE_DATA_DIR=var
# 可选数据库 URL；默认使用 var/mailpulse.sqlite3。当前 reset-db 仅支持文件型 SQLite。
# MAILPULSE_DATABASE_URL=sqlite:///var/mailpulse.sqlite3
MAILPULSE_LOG_LEVEL=INFO
MAILPULSE_LOG_ROTATION="00:00"
MAILPULSE_LOG_RETENTION="30 days"
MAILPULSE_SESSION_COOKIE=mailpulse_session
MAILPULSE_REMEMBER_ME_DAYS=30
# “记住密码”保存的账号凭据 Cookie 有效期（天）。Cookie 内容使用凭据密钥加密。
MAILPULSE_REMEMBER_PASSWORD_DAYS=30
# 通过 HTTPS 部署时设为 true；本地 HTTP 开发保持 false。
MAILPULSE_SESSION_HTTPS_ONLY=false

# 必须替换为随机长字符串；生产环境不能使用示例值。
MAILPULSE_SECRET_KEY=replace-with-a-random-session-secret
MAILPULSE_CREDENTIAL_KEY=replace-with-a-separate-credential-secret

# 首次启动且数据库中没有管理员时使用；通常保持默认值即可。
# 用户名是账号登录标识；报告投递邮箱在定时任务的“投递目标”中配置。
# MAILPULSE_DEFAULT_ADMIN_USERNAME=admin
# MAILPULSE_DEFAULT_ADMIN_PASSWORD=admin123
# MAILPULSE_DEFAULT_ADMIN_DISPLAY_NAME=系统管理员

# 默认只允许访问本机 AI 服务；外部 AI 必须经过明确策略审核。
MAILPULSE_EXTERNAL_AI_ALLOWED=false

# 可选：不使用管理员模型目录时，可通过环境变量配置主模型。
# MAILPULSE_AI_BASE_URL=http://127.0.0.1:8000/v1
# MAILPULSE_AI_API_KEY=replace-with-your-local-model-key
# MAILPULSE_AI_MODEL=Qwen3.8-27B-MLX-4bit
# MAILPULSE_AI_PRIMARY_SUPPORTS_IMAGE=false
# MAILPULSE_AI_PRIMARY_SUPPORTS_STRUCTURED_OUTPUT=true
# MAILPULSE_AI_VISION_BASE_URL=http://127.0.0.1:8001/v1
# MAILPULSE_AI_VISION_API_KEY=replace-with-your-vision-model-key
# MAILPULSE_AI_VISION_MODEL=按服务实际提供的视觉模型名称填写
# MAILPULSE_AI_VISION_SUPPORTS_STRUCTURED_OUTPUT=true

# AI 调用与报告输入限制；管理员模型配置可以按模型单独覆盖运行策略。
MAILPULSE_AI_TIMEOUT_SECONDS=90
MAILPULSE_AI_MAX_OUTPUT_TOKENS=1800
MAILPULSE_AI_MAX_INPUT_CHARS=120000
MAILPULSE_AI_MAX_RETRIES=2
MAILPULSE_MAX_MESSAGES_PER_REPORT=100

# 附件与本地存储限制，单位为字节的配置项请按部署容量调整。
MAILPULSE_MAX_ATTACHMENT_BYTES=20971520
MAILPULSE_MAX_ATTACHMENTS_PER_MESSAGE=20
MAILPULSE_MAX_IMAGE_ASSETS_PER_ATTACHMENT=20
MAILPULSE_MAX_IMAGE_BYTES=10485760
MAILPULSE_MAX_USER_STORAGE_BYTES=536870912
MAILPULSE_MAX_GLOBAL_STORAGE_BYTES=10737418240
